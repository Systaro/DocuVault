# =============================================================
# DocuVault Environment Configuration
# Copy this file to .env and fill in all values before starting
# =============================================================

# Database
DB_NAME=docuvault
DB_USERNAME=docuvault
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# JWT Secret - generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# Mail (any SMTP relay)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Initial admin: leave blank to use the in-browser setup wizard on first boot.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# OpenAI API Key for AI features (optional)
OPENAI_API_KEY=

# GitLab Configuration (optional, used for the GitLab sync feature)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# Meeting transcription bot (optional). Only used by the `meeting-bot` compose
# profile: `docker compose --profile meeting-bot up -d`.
# DISCORD_BOT_TOKEN comes from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# MEETING_TRANSCRIBE_MODEL=gpt-4o-transcribe
# MEETING_NOTES_MODEL=gpt-5.5
