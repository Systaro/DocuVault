# =============================================================
# DocuVault Environment Configuration
# Copy this file to .env and fill in all values before starting
# =============================================================

# Database
DB_NAME=docuvault
DB_USERNAME=docuvault
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# JWT Secret - generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET

# Mail (Postal relay via mailrelay.systaro.de)
MAIL_HOST=mailrelay.systaro.de
MAIL_PORT=25
MAIL_USERNAME=systaro-gmbh/docuvault
MAIL_PASSWORD=<credential-key-from-postal-ui>

# Admin account (created on first startup if no admin exists)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# OpenAI API Key for AI features (optional)
OPENAI_API_KEY=

# GitLab Configuration (optional)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
