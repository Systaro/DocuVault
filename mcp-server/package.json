{
  "name": "@systaro/docuvault-mcp",
  "version": "1.3.0",
  "description": "MCP server for DocuVault — Claude Code integration for reading and writing documentation",
  "homepage": "https://github.com/dularion/DocuVault#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dularion/DocuVault.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/dularion/DocuVault/issues"
  },
  "author": "Systaro GmbH",
  "main": "dist/index.js",
  "bin": {
    "docuvault-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "docuvault",
    "documentation",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
