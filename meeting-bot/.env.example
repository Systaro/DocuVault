# At least one adapter must be configured. The bot starts the Discord adapter
# when DISCORD_TOKEN is set and the Teams adapter when MEETING_BOT_DISPATCH_TOKEN
# is set; both can run in the same process.

# --- Discord adapter ---
# Discord bot token — https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# --- Teams adapter ---
# Shared secret matching app.meeting-bot.dispatch-token on the backend. Set this
# to enable the Teams adapter: the bot polls DocuVault for pending Teams invites
# and joins each meeting as a headless-browser guest. Leave blank to disable.
MEETING_BOT_DISPATCH_TOKEN=
# Display name the bot joins Teams meetings under (shown in the lobby).
TEAMS_BOT_NAME=DocuVault Notetaker
# How often to poll for pending Teams invites, in ms.
TEAMS_POLL_MS=15000
# Cap on simultaneous Teams meetings (each is a headless Chromium).
MEETING_MAX_CONCURRENT_TEAMS=2
# Set to 0 to watch Chromium locally (non-headless) while debugging.
TEAMS_HEADLESS=1
# How long to wait in the lobby for a human to admit the bot, in ms.
TEAMS_ADMIT_TIMEOUT_MS=120000

# OpenAI key used for transcription (Discord path) + meeting-note generation (both)
OPENAI_API_KEY=

# Base URL of the DocuVault API (note the /api context path).
# Inside docker-compose this is http://backend:7030/api
DOCUVAULT_API_URL=http://localhost:7030/api

# Optional model overrides
TRANSCRIBE_MODEL=gpt-4o-transcribe
NOTES_MODEL=gpt-5.5

# Milliseconds of silence that ends a speaker's utterance
SILENCE_MS=1200

# Hard cap on meeting length (safety stop)
MAX_MEETING_MINUTES=180
