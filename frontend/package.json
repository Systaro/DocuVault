{
  "name": "docuvault",
  "version": "0.0.1",
  "description": "DocuVault — self-hosted documentation platform with Git as the source of truth",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/dularion/DocuVault.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/dularion/DocuVault#readme",
  "bugs": {
    "url": "https://github.com/dularion/DocuVault/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 7031",
    "build": "ng build",
    "build:native": "ng build --configuration native",
    "build:native:dev": "ng build --configuration native-dev",
    "cap:sync": "npm run build:native && cap sync",
    "cap:sync:dev": "npm run build:native:dev && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@tiptap/core": "^2.3.0",
    "@tiptap/extension-code-block-lowlight": "^2.3.0",
    "@tiptap/extension-highlight": "^2.3.0",
    "@tiptap/extension-image": "^2.3.0",
    "@tiptap/extension-link": "^2.3.0",
    "@tiptap/extension-placeholder": "^2.3.0",
    "@tiptap/extension-table": "^2.3.0",
    "@tiptap/extension-table-cell": "^2.3.0",
    "@tiptap/extension-table-header": "^2.3.0",
    "@tiptap/extension-table-row": "^2.3.0",
    "@tiptap/extension-task-item": "^2.3.0",
    "@tiptap/extension-task-list": "^2.3.0",
    "@tiptap/pm": "^2.3.0",
    "@tiptap/starter-kit": "^2.3.0",
    "highlight.js": "^11.9.0",
    "lowlight": "^3.1.0",
    "marked": "^12.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "turndown": "^7.1.2",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.1",
    "@types/jasmine": "~5.1.0",
    "@types/turndown": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.4.0"
  }
}
