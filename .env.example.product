# ============================================================================
# DocuVault — production .env template
# ============================================================================
# Copy this file to .env in the same directory as docker-compose.product.yml,
# fill in the required values, then run: ./deploy.sh v0.1.0
#
# Generate strong random values with:   openssl rand -base64 48

# ---------------------------------------------------------------------------
# Public hostname & TLS (required)
# ---------------------------------------------------------------------------
# The DNS name your users will visit. Must already point at this server.
PUBLIC_HOSTNAME=

# Email used by Let's Encrypt for cert expiry notices.
LETSENCRYPT_EMAIL=

# ---------------------------------------------------------------------------
# Image registry credentials (required)
# ---------------------------------------------------------------------------
# Provided by Systaro. deploy.sh runs `docker login` automatically when these
# are set; skip them if your docker is already authenticated.
DOCUVAULT_REGISTRY_USER=
DOCUVAULT_REGISTRY_TOKEN=

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DB_NAME=docuvault
DB_USERNAME=docuvault
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Secrets (required)
# ---------------------------------------------------------------------------
# Used for session signing AND data encryption (when ENCRYPTION_KEY is unset).
# Treat as permanent — rotating invalidates existing sessions and may render
# encrypted columns unreadable. Generate with: openssl rand -base64 64
JWT_SECRET=

# Optional: separate key for at-rest encryption. Defaults to JWT_SECRET if empty.
ENCRYPTION_KEY=

# Redis password. Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# MinIO (object storage for logos and uploads).
MINIO_ROOT_USER=docuvault
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Initial admin account (required, used on first start only)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Outbound email / SMTP (required for invites, notifications, password reset)
# ---------------------------------------------------------------------------
# Point at any SMTP relay you control. Without this, the app runs but cannot
# send mail.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# HELO/EHLO name presented to the SMTP relay (defaults to PUBLIC_HOSTNAME).
MAIL_SMTP_LOCALHOST=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# OpenAI API key — enables AI features (semantic search, summarisation).
# Without it the app works but those features are disabled.
OPENAI_API_KEY=

# GitLab integration — required only if you use the "sync from GitLab" feature.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# ---------------------------------------------------------------------------
# Pinned version (managed by deploy.sh — do not edit manually)
# ---------------------------------------------------------------------------
# DOCUVAULT_VERSION=
