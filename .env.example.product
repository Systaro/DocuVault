# ============================================================================
# DocuVault — production .env template
# ============================================================================
# Copy this file to .env in the same directory as docker-compose.product.yml,
# fill in the required values, then run: ./deploy.sh latest
#
# Generate strong random values with:   openssl rand -base64 48

# ---------------------------------------------------------------------------
# Public hostname & TLS (required)
# ---------------------------------------------------------------------------
# The DNS name your users will visit. Must already point at this server.
PUBLIC_HOSTNAME=

# Email used by Let's Encrypt for cert expiry notices.
LETSENCRYPT_EMAIL=

# ---------------------------------------------------------------------------
# Image registry (optional)
# ---------------------------------------------------------------------------
# The images are public on ghcr.io/systaro/docuvault and need no login.
# Only set these when pulling from a private registry instead; deploy.sh
# runs `docker login` when user and token are set.
# DOCUVAULT_IMAGE_PREFIX=registry.example.com/docuvault
# DOCUVAULT_REGISTRY_HOST=registry.example.com
DOCUVAULT_REGISTRY_USER=
DOCUVAULT_REGISTRY_TOKEN=

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
DB_NAME=docuvault
DB_USERNAME=docuvault
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Secrets (required)
# ---------------------------------------------------------------------------
# Used for session signing AND data encryption (when ENCRYPTION_KEY is unset).
# Treat as permanent — rotating invalidates existing sessions and may render
# encrypted columns unreadable. Generate with: openssl rand -base64 64
JWT_SECRET=

# Optional: separate key for at-rest encryption. Defaults to JWT_SECRET if empty.
ENCRYPTION_KEY=

# Redis password. Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# MinIO (object storage for logos and uploads).
MINIO_ROOT_USER=docuvault
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Initial admin
# ---------------------------------------------------------------------------
# On first boot with an empty database, visit https://<PUBLIC_HOSTNAME>/setup
# in your browser to create the administrator account. No env vars needed.

# ---------------------------------------------------------------------------
# Outbound email / SMTP (recommended: invites, notifications, password reset)
# ---------------------------------------------------------------------------
# Point at any SMTP relay you control. Without this, the app runs but cannot
# send mail.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# HELO/EHLO name presented to the SMTP relay (defaults to PUBLIC_HOSTNAME).
MAIL_SMTP_LOCALHOST=
# FROM address on outbound emails. Must be a domain your SMTP relay is
# authorised to send for (verify SPF/DKIM at the relay or your DNS).
MAIL_FROM_ADDRESS=
# Sender name; empty uses the app name from Admin → Branding.
MAIL_FROM_NAME=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# OpenAI API key — enables AI features (semantic search, summarisation).
# Without it the app works but those features are disabled.
OPENAI_API_KEY=

# GitLab integration — required only if you use the "sync from GitLab" feature.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=

# ---------------------------------------------------------------------------
# Discord meeting transcription bot (optional)
# ---------------------------------------------------------------------------
# Setting DISCORD_BOT_TOKEN enables a Discord bot that joins a voice call,
# transcribes per speaker, and files notes into a space's inbox. Setup:
#   1. Create a Discord application at https://discord.com/developers/applications
#      → Bot tab → Reset Token → paste here.
#   2. Make sure OPENAI_API_KEY above is set (used for transcription + notes).
#   3. Run `./deploy.sh <version>` — when DISCORD_BOT_TOKEN is set, deploy.sh
#      automatically includes the bot in the pull/up cycle.
# Full setup walkthrough: docs/meeting-bot.md
DISCORD_BOT_TOKEN=
# Optional model overrides — leave commented to use defaults.
# MEETING_TRANSCRIBE_MODEL=gpt-4o-transcribe
# MEETING_NOTES_MODEL=gpt-5.5

# ---------------------------------------------------------------------------
# Pinned version (managed by deploy.sh — do not edit manually)
# ---------------------------------------------------------------------------
# DOCUVAULT_VERSION=
